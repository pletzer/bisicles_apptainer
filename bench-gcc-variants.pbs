#!/bin/bash
#PBS -N bisicles-gccvar-run
#PBS -P reannz40001
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l place=excl
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o gccvar-run-cascade.log
##PBS -q workq                       # default queue; shortq/longq also exist

# PBS equivalent of bench-gcc-variants.sl (Cascade, AMD EPYC 9254 / znver4).
# Run every gcc/<variant>/driver2d on the MISMIP3D P075 L1L2 case (level 3,
# 40 steps, 16 ranks, one exclusive node), interleaved with rotating order, then
# compare each final checkpoint against the v0-default baseline.
# Submit from the repo root, after the builds:
#   B=$(qsub build-gcc-variants.pbs); qsub -W depend=afterokarray:$B bench-gcc-variants.pbs
#   (or just: qsub bench-gcc-variants.pbs  once gcc/*/driver2d* exist)
# Env (qsub -v): REPEAT (3) LEVEL (3) NSTEPS (40) NP (16)
cd "${PBS_O_WORKDIR:?}"
unset LD_LIBRARY_PATH
set -uo pipefail
source ./gcc-variants.sh
REPEAT=${REPEAT:-3}; LEVEL=${LEVEL:-3}; NSTEPS=${NSTEPS:-40}; NP=${NP:-16}
SRC_DIR=$(realpath "${SRC_DIR:-..}")
SIF=$(realpath "$SRC_DIR/sifs/gcc/bisicles-deps.sif")
W=$PBS_O_WORKDIR/gccvar-work-${PBS_JOBID%%.*}
OUT=$PBS_O_WORKDIR/results-gcc-variants
rm -rf "$OUT"; mkdir -p "$W" "$OUT"
echo "node: $(hostname)"; lscpu | grep 'Model name'
INP=inputs.mismip3D.p075.l1l2.l$LEVEL

for v in "${VARIANTS[@]}"; do
  R=$W/$v; mkdir -p "$R"
  cp "$SRC_DIR"/BISICLES/examples/MISMIP3D/{inputs.mismip3D.p075.template,make_inputs.sh,l1l2.4096.500mm.hdf5} "$R"/
  (cd "$R" && sh make_inputs.sh > /dev/null &&
   sed -i -e "s/^main.maxStep.*/main.maxStep = $NSTEPS/" \
          -e "s/^amr.check_interval.*/amr.check_interval = $NSTEPS/" \
          -e "s/^amr.plot_time_interval.*/amr.plot_time_interval = 1.0e10/" $INP)
done

declare -A TIMES FAILED
n=${#VARIANTS[@]}
for i in $(seq 0 $((REPEAT-1))); do
  for k in $(seq 0 $((n-1))); do
    v=${VARIANTS[$(( (k + i) % n ))]}          # rotate the order every repeat
    R=$W/$v; EXE=$(ls "$PBS_O_WORKDIR"/gcc/$v/driver2d.Linux.64.*.ex)
    cd "$R"; rm -f chk.*.hdf5 pout.*
    t0=$(date +%s.%N)
    if apptainer exec --cleanenv -B "$W" -B "$PBS_O_WORKDIR/gcc" "$SIF" \
         bash -c "cd $R && mpirun -np $NP $EXE $INP" > run.out 2>&1; then
      t=$(echo "$(date +%s.%N) - $t0" | bc)
      TIMES[$v]="${TIMES[$v]:-} $t"
      printf 'repeat %d  %-32s %6.1f s\n' "$((i+1))" "$v" "$t"
    else
      FAILED[$v]=1; echo "repeat $((i+1))  $v FAILED"; tail -15 run.out; tail -15 pout.0 2>/dev/null
    fi
    cd "$PBS_O_WORKDIR"
  done
done

stats() { printf '%s\n' $1 | sort -g | awk '{a[NR]=$1} END { if (!NR) {print "    n/a"; exit}
  m = (NR % 2) ? a[(NR+1)/2] : (a[NR/2] + a[NR/2+1]) / 2
  printf "%7.1f %7.1f %7.1f", m, a[1], a[NR] }'; }
for v in "${VARIANTS[@]}"; do
  D=$OUT/$v; mkdir -p "$D"
  [ -n "${FAILED[$v]:-}" ] && continue
  cp "$(ls "$W/$v"/chk.*.hdf5 | tail -1)" "$W/$v/pout.0" "$D"/
  cp "$PBS_O_WORKDIR/gcc/$v/flags.txt" "$D"/
done
base=$(stats "${TIMES[v0-default]:-}" | awk '{print $1}')
{
  echo "# $(date '+%F %T') GCC FLAG VARIANTS node=$(hostname) $(lscpu | grep -m1 'Model name' | sed 's/  */ /g') NP=$NP LEVEL=$LEVEL NSTEPS=$NSTEPS REPEAT=$REPEAT (exclusive node, rotated order)"
  printf '%-32s %7s %7s %7s %8s   %s\n' variant median min max speedup runs
  for v in "${VARIANTS[@]}"; do
    med=$(stats "${TIMES[$v]:-}" | awk '{print $1}')
    printf '%-32s %s %8.2fx   %s\n' "$v" "$(stats "${TIMES[$v]:-}")" "$(echo "$base / $med" | bc -l)" "$(printf ' %.1f' ${TIMES[$v]:-})"
  done
} | tee "$OUT/timings.txt" | tee -a gcc-variants-timings.txt

# compare_chk.py needs python3 with h5py + numpy; try the usual modules first
module load h5py > /dev/null 2>&1 || module load Python > /dev/null 2>&1 || true
if python3 -c 'import h5py, numpy' 2>/dev/null; then
  for v in "${VARIANTS[@]:1}"; do
    [ -d "$OUT/$v" ] && python3 compare_chk.py "$OUT/v0-default" "$OUT/$v"
  done > "$OUT/compare.txt" 2>&1
else
  echo "python3 with h5py/numpy not available; checkpoints kept in $OUT," \
       "run compare_chk.py $OUT/v0-default $OUT/<variant> elsewhere" | tee "$OUT/compare.txt"
fi
echo "=== worst relative L2 difference vs v0-default (full detail: $OUT/compare.txt)"
awk '/^====/ {name=$4} /worst relative/ {printf "%-32s %s\n", name, $NF}' "$OUT/compare.txt" | tee "$OUT/worst.txt"
rm -rf "$W"
echo "=== DONE"
